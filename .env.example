# NCBI Entrez (MeSH entities)
ENTREZ_EMAIL=your_email@example.com
ENTREZ_API_KEY=

# Neo4j (only for --export-neo4j)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me-please
NEO4J_DATABASE=neo4j

# LLM providers (only the one you use is needed)
GOOGLE_API_KEY=
GROQ_API_KEY=

# Experiment tracking; leave MLFLOW_TRACKING_URI empty for a local SQLite store
MLFLOW_TRACKING_URI=
GRAPH_RAG_MLFLOW_EXPERIMENT=graph-rag
GRAPH_RAG_TRACKING=true

# Temporal (docker compose defaults)
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=graph-rag

# Hugging Face Hub (hub push / private hf:// artifacts)
HF_TOKEN=
